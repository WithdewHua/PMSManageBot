# 站点名字
SITE_NAME="PMS"
# plex 相关配置
# Plex 注册开关已迁移到管理后台
# plex 地址
PLEX_BASE_URL=""
PLEX_API_TOKEN=""
PLEX_ADMIN_USER=""
PLEX_ADMIN_EMAIL=""

# Overseerr 相关配置
OVERSEERR_BASE_URL=""
OVERSEERR_API_TOKEN=""

# 可变业务配置已迁移到管理后台并持久化在数据库

# TG 相关配置
TG_API_TOKEN=""
TG_ADMIN_CHAT_ID=123456789
TG_GROUP=""
# 可选的通知频道链接，如果不设置将使用群组链接
TG_CHANNEL=""  
TG_CHANNEL_ID=""

# TG miniapp 相关配置
# 是否启用 WebApp
ENABLE_WEBAPP=True  
WEBAPP_PORT= 5000
WEBAPP_HOST= "127.0.0.1"
# WebApp 前端静态文件目录
WEBAPP_STATIC_DIR="../webapp-frontend/dist"
# 用于会话加密的密钥
SESSION_SECRET_KEY=

# tautulli 相关配置
TAUTULLI_URL=""
TAUTULLI_APIKEY=""
TAUTULLI_PUBLIC_URL="/"
TAUTULLI_VERIFY_SSL=False

# emby 相关配置
# Emby 注册开关已迁移到管理后台
EMBY_BASE_URL=""
EMBY_API_TOKEN=""
EMBY_ADMIN_USER=""
EMBY_USER_TEMPLATE=""
EMBY_USER_IS_HIDDEN=True

# 播放后端线路
STREAM_BACKEND=
PREMIUM_STREAM_BACKEND=
# Premium Free 开关已迁移到管理后台

# redis 相关配置
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# UPAY 支付配置
UPAY_BASE_URL="http://localhost:8090"
# upay 签名密钥
UPAY_SECRET_KEY=""
# UPAY 支持币种已迁移到管理后台

# Vaultwarden 兑换开关和积分已迁移到管理后台
# Vaultwarden 服务地址
VAULTWARDEN_BASE_URL=""
VAULTWARDEN_ADMIN_TOKEN=""


# 数据库配置
# 数据库类型: sqlite, postgresql，默认 sqlite
DATABASE_TYPE="sqlite"
# 完整数据库连接 URL，优先级最高，可选
# PostgreSQL 支持 postgresql://（psycopg2）及 postgresql+psycopg://（psycopg 3）
# 也可借此连接受支持范围之外的数据库（如 mysql+pymysql://...），
# 但需自行安装对应驱动，且该用法不受支持、不作保证
DATABASE_URL=""
# PostgreSQL 配置，可选
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="pmsmanagebot"
POSTGRES_PASSWORD=""
POSTGRES_DB="pmsmanagebot"

# Ethereum JSON-RPC
ETH_RPC_URL=""
